function induction_project_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  if ($form_id == 'webform_submission_contact_webform_node_11_add_form') {
    $form['actions']['submit']['#value'] = t("let's go");
    $form['elements']['name']['#title'] = t("_*Please enter your first name*_");
    $form['elements']['description']['#description'] = t('Please enter some comments here!');
    shuffle($form['elements']['what_vehicle_do_you_own']['#options']);
    //    $form["elements"]["what_vehicle_do_you_own"]["#type"] = 'checkboxes';
    $form['tos'] = [
      '#type' => 'checkbox',
      '#title' => t('Terms of service'),
      '#weight' => 4,
    ];
  }
  if ($form_id == 'induction_project_form') {
    //var_dump($form);
    $form['custom_text']['#title'] = t("let's go");
  }
  //  var_dump($form);
}

/**
 * Implements hook_theme().
 */
function induction_project_theme() {
  return [
    'node__car' => [
      'base hook' => 'node',
    ],
    'paragraph__multimedia' => [
      'base hook' => 'paragraph',
    ],
    'paragraph__content_with_link' => [
      'base hook' => 'paragraph',
    ],
    'vehicle_template' => [
      'variables' => [
        'hello_world' => NULL,
        'vehicle_title' => t("No title provided"),
        'authors_name' => t("No authors provided"),
      ],
    ],
    'custom_field_formatter' => [
      'variables' => [
        'field_value' => NULL,
      ],
      'template' => 'custom-field-formatter',
    ],
    'published_theme' => [
      'variables' => [
        'published_text' => '',
      ]
    ],
  ];
}


