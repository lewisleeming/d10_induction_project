/**
 * Preprocess paragraphs
 */
function induction_project_preprocess_paragraph__content_with_link(&$variables): void {
  $variables['content_with_link_title'] = $variables["paragraph"]->get('field_title')->value;
}

function induction_project_preprocess_paragraph__multimedia(&$variables): void {
  $variables['multimedia_title'] = $variables["paragraph"]->get('field_multimedia_title')->value;
}

function induction_project_preprocess_paragraph(&$variables): void {
  $variables['hello_world'] = t('generic titles for paras');
}

