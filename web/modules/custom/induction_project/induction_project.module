<?php

use Drupal\Core\Form\FormStateInterface;

/**
 * @file
 * Primary module hooks for induction_project module.
 */
function induction_project_preprocess_node(&$variables) {
  //  $variables['car_title'] = $variables["node"]->label();
  //  $variables['car_owner'] = $variables["node"]->getOwner()->label();
  //  $variables['car_owner'] = $variables["node"]->get('field_brand')->entity->get('field_region')->value
  $entities = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties(['type' => 'car']);
  $all_car_data = [];
  foreach ($entities as $car) {
    // Store the data in the all_car_data array.
    $all_car_data[] = [
      'car_title' => $car->label(),
      'car_owner' => $car->getOwner()->label(),
      'car_region' => !$car->get('field_brand')
        ->isEmpty() ? $car->get('field_brand')->entity->get('field_region')->value : 'not found',
    ];
  }
  $variables['all_car_data'] = $all_car_data;
}
